exports[`ModalDialog on macOS (characterization: what every Mac user has today) > renders this exact markup 1`] = `"<div aria-modal="true" tabindex="-1" class="modal-overlay " role="dialog" aria-labelledby="conv-title"><div class="modal-dialog" style="left: 0px; top: 0px;"><button class="modal-close-button" tabindex="-1" aria-label="Close">×</button> <div class="modal-content"><div class="dialog-title-bar draggable"><h2 id="conv-title"><span>Save changes</span></h2></div> <div class="modal-body"><div><label for="name-field">Name</label><input id="name-field"><button id="options">Options</button></div></div>  <div class="modal-footer"> <div class="modal-footer-actions"><button id="cancel">Cancel</button><button id="save">Save</button></div> </div></div> </div></div>"`;

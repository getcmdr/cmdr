      },
      "path": "smb://[fe80::1]",
      "key": "fe80::1",
      "port": 445
    },
    {
      "why": "A manual IPv6 server off 445: its label carries the port, its key doesn't",
      "host": {
        "id": "manual---1-4450",
        "name": "::1:4450",
        "hostname": "::1",
        "ipAddress": "::1",
        "port": 4450,

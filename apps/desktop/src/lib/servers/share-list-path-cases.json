      "path": "smb://testnas:4450",
      "key": "testnas",
      "port": 4450
    },
    {
      "why": "A discovered server nothing resolved yet has the same key",
      "host": { "id": "testnas2", "name": "Testnas2", "port": 445, "source": "discovered" },
      "path": "smb://testnas2",
      "key": "testnas2",
      "port": 445
    },
    {
      "why": "A manual server goes by the address the person typed, ❌ never its label",
      "host": {
        "id": "manual-TestNAS-local-445",
        "name": "TestNAS.local",
        "hostname": "TestNAS.local",
        "port": 445,
        "source": "manual"
      },
      "path": "smb://testnas.local",
      "key": "testnas.local",
      "port": 445
    },
    {
      "why": "A manual IPv4 server",
      "host": {
        "id": "manual-192-168-50-21-445",
        "name": "192.168.50.21",
        "hostname": "192.168.50.21",
        "ipAddress": "192.168.50.21",
        "port": 445,
        "source": "manual"
      },
      "path": "smb://192.168.50.21",
      "key": "192.168.50.21",
      "port": 445
    },
    {
      "why": "A manual IPv6 server is bracketed, its own colons kept",
      "host": {
        "id": "manual-fe80--1-445",
        "name": "fe80::1",
        "hostname": "fe80::1",
        "ipAddress": "fe80::1",
        "port": 445,

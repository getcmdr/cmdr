      },
      "path": "smb://[::1]:4450",
      "key": "::1",
      "port": 4450
    },
    {
      "why": "A name holding the path grammar's own characters escapes them, so the authority stays one token",
      "host": { "id": "testnas2", "name": "Test: NAS/2", "port": 445, "source": "discovered" },
      "path": "smb://test%3A nas%2F2",
      "key": "test: nas/2",
      "port": 445
    },
    {
      "why": "A percent sign escapes too, so decoding is unambiguous",
      "host": { "id": "100nas", "name": "100% NAS [attic]", "port": 445, "source": "discovered" },
      "path": "smb://100%25 nas %5Battic%5D",
      "key": "100% nas [attic]",
      "port": 445
    }
  ],
  "spellings": [
    { "why": "The reader folds an explicit 445", "path": "smb://testnas:445", "key": "testnas", "port": 445 },
    { "why": "The reader folds case", "path": "smb://TestNAS", "key": "testnas", "port": 445 },
    { "why": "Either hex case decodes", "path": "smb://test%3a nas", "key": "test: nas", "port": 445 },
    {
      "why": "Rust spells a scheme root with a trailing `/`, which the reader folds",
      "path": "smb://testnas:4450/",
      "key": "testnas",
      "port": 4450
    }
  ],
  "notShareLists": [
    { "why": "The hub", "path": "smb://" },
    { "why": "The hub, as Rust spells it", "path": "smb:///" },
    { "why": "Two separators after the server", "path": "smb://testnas//" },
    { "why": "A share is mounted, ❌ never a share list", "path": "smb://testnas/archive" },
    { "why": "Another scheme", "path": "sftp://testnas" },
    { "why": "A local path", "path": "/Volumes/testnas" },
    { "why": "No port after the colon", "path": "smb://testnas:" },
    { "why": "Port zero", "path": "smb://testnas:0" },
    { "why": "A port past 65535", "path": "smb://testnas:65536" },
    { "why": "A port that isn't digits", "path": "smb://testnas:abc" },
    { "why": "Two bare colons: a name's colon is always escaped", "path": "smb://a:b:445" },
    { "why": "An unclosed bracket", "path": "smb://[fe80::1" },
    { "why": "Something after the bracket that isn't a port", "path": "smb://[fe80::1]x" },
    { "why": "An empty key", "path": "smb://:4450" },
    { "why": "An escape that isn't hex", "path": "smb://test%zz" },
    { "why": "A cut-off escape", "path": "smb://test%2" },
    { "why": "An escape past ASCII, which the writer never makes", "path": "smb://test%C3" },
    { "why": "A bare bracket inside a name, which the writer always escapes", "path": "smb://a]b" },
    { "why": "A bracketed name that isn't an IPv6 address", "path": "smb://[testnas]" }
  ]

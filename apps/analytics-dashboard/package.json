{
  "name": "@cmdr/analytics-dashboard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev --port 4830",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:no-sync": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,svelte}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "uplot": "^1.6.32",
    "visionscarto-world-atlas": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "knip": "6.44.2",
    "oxlint": "^1.94.0",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.1.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}

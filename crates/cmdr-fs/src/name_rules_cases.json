    },
    {
      "name": "aux.",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "endsWithSpaceOrPeriod",
      "windowsDisk": "reservedName",
      "reserved": "aux",
      "why": "Linux takes a reserved name but strips the trailing period: the refusal wins over the warning"
    }
  ]
}

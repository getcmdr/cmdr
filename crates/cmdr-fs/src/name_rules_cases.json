{
  "about": "Which names each destination takes. Run by crates/cmdr-fs/src/validation_name_rules_test.rs and apps/desktop/src/lib/utils/filename-validation.test.ts, so the Rust rule and its keystroke mirror can't drift. `rules` are NameRules values as they cross IPC: a plain POSIX disk, APFS, HFS+ (which stores names decomposed, so it counts them that way), an SMB share, a Windows-format stick written from a Mac (whose driver stores stand-ins, so it warns), from Linux (whose vfat and exfat drivers refuse the characters and strip a trailing period), and a Windows disk written from Windows. Each case is `name` (or `repeat` copies of it), and per rules set either \"ok\", the ValidationError kind it refuses with, or \"warn:\" plus the PortabilityWarning kind it's taken with. `all` answers for every rules set the case doesn't name.",
  "rules": {
    "posix": {
      "format": "posix",
      "windowsCharacters": "allow",
      "reservedNames": "allow",
      "nameLimit": { "max": 255, "unit": "bytes" },
      "pathLimit": null
    },
    "apfs": {
      "format": "posix",
      "windowsCharacters": "allow",
      "reservedNames": "allow",
      "nameLimit": { "max": 255, "unit": "utf16Units" },
      "pathLimit": { "max": 1023, "unit": "bytes" }
    },
    "share": {
      "format": "smbShare",
      "windowsCharacters": "warn",
      "reservedNames": "warn",
      "nameLimit": { "max": 255, "unit": "bytes" },
      "pathLimit": { "max": 32767, "unit": "utf16Units" }
    },
    "hfsPlus": {
      "format": "posix",
      "windowsCharacters": "allow",
      "reservedNames": "allow",
      "nameLimit": { "max": 255, "unit": "utf16UnitsDecomposed" },
      "pathLimit": { "max": 1023, "unit": "bytes" }
    },
    "stickOnMac": {
      "format": "windows",
      "windowsCharacters": "warn",
      "reservedNames": "warn",
      "nameLimit": { "max": 255, "unit": "utf16Units" },
      "pathLimit": { "max": 1023, "unit": "bytes" }
    },
    "stickOnLinux": {
      "format": "windows",
      "windowsCharacters": "refuse",
      "reservedNames": "warn",
      "nameLimit": { "max": 255, "unit": "utf16Units" },
      "pathLimit": { "max": 4095, "unit": "bytes" }
    },
    "windowsDisk": {
      "format": "windows",
      "windowsCharacters": "refuse",
      "reservedNames": "refuse",
      "nameLimit": { "max": 255, "unit": "utf16Units" },
      "pathLimit": { "max": 32767, "unit": "utf16Units" }
    }
  },
  "cases": [
    { "name": "document.txt", "all": "ok" },
    { "name": ".gitignore", "all": "ok" },
    { "name": "日本語ファイル.txt", "all": "ok" },
    { "name": " lead", "all": "ok", "why": "Windows keeps a leading space" },
    { "name": "a\u007fb", "all": "ok", "why": "DEL isn't a control character any of the formats refuse" },
    { "name": "CONIN$", "all": "ok" },
    { "name": "CONSOLE", "all": "ok" },
    { "name": "COM10", "all": "ok" },
    { "name": "LPT", "all": "ok" },
    { "name": "", "all": "empty" },
    { "name": "   ", "all": "empty" },
    { "name": "\t\n\r", "all": "empty" },
    {
      "name": " 　 ",
      "all": "empty",
      "why": "no-break, ideographic, and line-separator spaces are Unicode White_Space"
    },
    { "name": "\u0085", "all": "empty", "why": "NEL is Unicode White_Space, though JS trim() keeps it" },
    { "name": "﻿", "all": "empty", "why": "a byte-order mark renders as nothing" },
    { "name": "​", "all": "empty", "why": "a zero-width space renders as nothing" },
    { "name": "​‌‍⁠", "all": "empty" },
    { "name": " ​ ", "all": "empty", "why": "spaces and invisible characters together are still nothing" },
    {
      "name": "᠎",
      "all": "empty",
      "why": "the Mongolian vowel separator left White_Space in Unicode 6.3, and renders as nothing"
    },
    { "name": "ㅤ", "all": "empty", "why": "the Hangul filler renders blank" },
    { "name": "⠀", "all": "empty", "why": "the braille blank renders blank" },
    {
      "name": "️͏­",
      "all": "empty",
      "why": "a variation selector, a grapheme joiner, and a soft hyphen show nothing alone"
    },
    { "name": "‮", "all": "empty", "why": "a bare bidi override shows nothing" },
    { "name": "a​", "all": "ok", "why": "an invisible character beside a visible one isn't an empty name" },
    { "name": ".", "all": "dotName" },
    { "name": "..", "all": "dotName" },
    { "name": "foo/bar", "all": "disallowedCharacter", "character": "/" },
    { "name": "foo\u0000bar", "all": "disallowedCharacter", "character": "NUL" },
    { "name": "a", "repeat": 255, "all": "ok", "why": "255 is the limit, not past it" },
    { "name": "a", "repeat": 256, "all": "nameTooLong" },
    {
      "name": "é",
      "repeat": 128,
      "all": "ok",
      "posix": "nameTooLong",
      "share": "nameTooLong",
      "hfsPlus": "nameTooLong",
      "why": "256 bytes, but 128 UTF-16 units: a byte-counting destination refuses it, a UTF-16 one takes it, and HFS+ stores it decomposed as 256 units"
    },
    {
      "name": "é",
      "repeat": 255,
      "all": "ok",
      "posix": "nameTooLong",
      "share": "nameTooLong",
      "hfsPlus": "nameTooLong"
    },
    {
      "name": "é",
      "repeat": 127,
      "all": "ok",
      "posix": "ok",
      "share": "ok",
      "why": "254 decomposed units: HFS+ takes it too"
    },
    {
      "name": "😀",
      "repeat": 128,
      "all": "nameTooLong",
      "why": "an emoji is two UTF-16 units and four bytes: over both limits"
    },
    {
      "name": "CON",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "CON"
    },
    {
      "name": "con.txt",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "con"
    },
    {
      "name": "nul.tar.gz",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "nul"
    },
    {
      "name": "CON .txt",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "CON"
    },
    {
      "name": "Aux",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "Aux"
    },
    {
      "name": "lpt9.log",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "lpt9"
    },
    {
      "name": "COM¹",
      "all": "ok",
      "share": "warn:reservedName",
      "stickOnMac": "warn:reservedName",
      "stickOnLinux": "warn:reservedName",
      "windowsDisk": "reservedName",
      "reserved": "COM¹"
    },
    {
      "name": "a:b",
      "all": "ok",
      "share": "warn:windowsCharacter",
      "stickOnMac": "warn:windowsCharacter",
      "stickOnLinux": "disallowedCharacter",
      "windowsDisk": "disallowedCharacter",
      "character": ":"
    },
    {
      "name": "a*b",
      "all": "ok",
      "share": "warn:windowsCharacter",
      "stickOnMac": "warn:windowsCharacter",
      "stickOnLinux": "disallowedCharacter",
      "windowsDisk": "disallowedCharacter",
      "character": "*"
    },
    {

    },
    {
      "name": "con:x.",
      "all": "ok",
      "share": "warn:windowsCharacter",
      "stickOnMac": "warn:windowsCharacter",
      "stickOnLinux": "disallowedCharacter",
      "windowsDisk": "disallowedCharacter",
      "character": ":",
      "why": "the first portability problem is the one named, and a refusal anywhere in the name beats a warning"
    },
    {
      "name": "nul.a:b",
      "all": "ok",
      "share": "warn:windowsCharacter",
      "stickOnMac": "warn:windowsCharacter",
      "stickOnLinux": "disallowedCharacter",
      "windowsDisk": "disallowedCharacter",

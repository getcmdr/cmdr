    { "name": "a>b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": ">" },
    { "name": "a|b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": "|" },
    { "name": "a\\b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": "\\" },
    { "name": "a\u0001b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": "U+0001" },

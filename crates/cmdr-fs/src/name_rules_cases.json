{
  "about": "Which names each NameRules takes. Run by crates/cmdr-fs/src/validation_name_rules_test.rs and apps/desktop/src/lib/utils/filename-validation.test.ts, so the Rust rule and its keystroke mirror can't drift. Each case is `name` (or `repeat` copies of it), and per rules either \"ok\" or the ValidationError kind it refuses with. A name refused by every rules set says so once, under `all`.",
  "cases": [
    { "name": "document.txt", "all": "ok" },
    { "name": ".gitignore", "all": "ok" },
    { "name": "日本語ファイル.txt", "all": "ok" },
    { "name": " lead", "all": "ok", "why": "Windows keeps a leading space" },
    { "name": "a\u007fb", "all": "ok", "why": "DEL isn't a control character any of the formats refuse" },
    { "name": "CONIN$", "all": "ok" },
    { "name": "CONSOLE", "all": "ok" },
    { "name": "COM10", "all": "ok" },
    { "name": "LPT", "all": "ok" },
    { "name": "", "all": "empty" },
    { "name": "   ", "all": "empty" },
    { "name": "foo/bar", "all": "disallowedCharacter", "character": "/" },
    { "name": "foo\u0000bar", "all": "disallowedCharacter", "character": "NUL" },
    { "name": "a", "repeat": 255, "all": "ok", "why": "255 bytes is the limit, not past it" },
    { "name": "a", "repeat": 256, "all": "nameTooLong" },
    { "name": "CON", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "CON" },
    { "name": "con.txt", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "con" },
    { "name": "nul.tar.gz", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "nul" },
    { "name": "CON .txt", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "CON" },
    { "name": "Aux", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "Aux" },
    { "name": "COM1", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "COM1" },
    { "name": "lpt9.log", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "lpt9" },
    { "name": "COM¹", "posix": "ok", "smbShare": "reservedName", "windows": "reservedName", "reserved": "COM¹" },
    { "name": "a:b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": ":" },
    { "name": "a*b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": "*" },
    { "name": "a?b", "posix": "ok", "smbShare": "ok", "windows": "disallowedCharacter", "character": "?" },

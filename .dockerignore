# Website Docker build - context is repo root
# Only include what's needed for the website build

# Ignore everything by default
*

# Allow workspace config
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
# `patchedDependencies` in pnpm-workspace.yaml: pnpm requires every patch file at install, even under a `--filter`
!patches/
!CHANGELOG.md
!feature-status.json
# The language count's source (`apps/website/src/lib/shipped-languages.ts`)
!apps/desktop/src-tauri/src/intl/shipped_locales.gen.rs
# The policy definition `/trust` lists its managed keys from (`apps/website/src/lib/trust-mdm.ts`)
!apps/desktop/src-tauri/src/managed_policy/policies.json
# `PUBLIC_DOWNLOAD_OSES`, the OSes the download buttons offer (`apps/website/src/lib/download-platforms.ts`)
!apps/api-server/wrangler.toml

# Allow website app
!apps/website/

# But ignore website build artifacts and node_modules
apps/website/node_modules
apps/website/dist
apps/website/nginx-generated
apps/website/.astro
apps/website/playwright-report
apps/website/test-results
